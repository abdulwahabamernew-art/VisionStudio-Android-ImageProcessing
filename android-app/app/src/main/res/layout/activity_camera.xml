<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#07111F">
 <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent"/>
 <ImageView android:id="@+id/processedOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0.96"/>
 <LinearLayout android:orientation="vertical" android:padding="12dp" android:background="#D90D1B2E" android:layout_gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="فلاتر الكاميرا المباشرة" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Spinner android:id="@+id/filterSpinner" android:layout_width="match_parent" android:layout_height="48dp"/>
  <TextView android:text="قوة الفلتر" android:textColor="#A9BCD2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <SeekBar android:id="@+id/filterStrength" android:max="100" android:progress="50" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="سرعة المعالجة (الأقل أسرع)" android:textColor="#A9BCD2" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <SeekBar android:id="@+id/frameInterval" android:max="7" android:progress="2" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/status" android:text="فلتر مباشر • كل 3 إطارات" android:textColor="#2ED3E3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/switchCamera" android:text="تبديل" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   <Button android:id="@+id/toggleProcess" android:text="تشغيل/إيقاف" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   <Button android:id="@+id/captureButton" android:text="التقاط" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>